{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "unicorn"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    // The codebase leans hard on refs, gestures and deliberate dependency
    // omissions to keep canvas state consistent. These two rules are the ones
    // that actually catch mistakes in that style, so they are errors, not hints.
    "react-hooks/exhaustive-deps": "error",
    "react-hooks/rules-of-hooks": "error"
  },
  "ignorePatterns": [".output", ".wxt", "node_modules", "public", "assets"]
}
