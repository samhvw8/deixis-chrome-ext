# Chrome Web Store submit credentials for `npm run submit`.
# Copy this file to `.env.submit` and fill in real values (that file is gitignored).
# See docs/publishing.md for how to obtain each value.

# Your extension's ID from the Chrome Web Store dashboard URL.
CHROME_EXTENSION_ID=

# OAuth client created in Google Cloud Console (Desktop app type).
CHROME_CLIENT_ID=
CHROME_CLIENT_SECRET=

# Refresh token generated once via the OAuth consent flow.
CHROME_REFRESH_TOKEN=

# Optional: "default" (submit for review) or "trustedTesters".
# CHROME_PUBLISH_TARGET=default
